{
  "_comment": "Profile matrix for Nexus V3. strict preserves legacy high-assurance behavior.",
  "profiles": {
    "fast": {
      "description": "Small low-risk changes: one implementer, scripts for graph/blast, optional unified review, one branch per request",
      "branchPolicy": "per-feature",
      "reviewPolicy": "unified-or-skip",
      "lessonPolicy": "noteworthy-only",
      "graphPolicy": "cache-by-file-hash",
      "blastPolicy": "per-execution-unit",
      "cleanupPolicy": "script",
      "batchTasks": true,
      "implementerPer": "execution-unit",
      "maxTasksPerBatch": 5,
      "requireDualReviewOn": [
        "security",
        "migration",
        "public-api",
        "high-blast"
      ]
    },
    "balanced": {
      "description": "Normal feature work: feature branch, batched implementer, risk-based review, LESSONS when noteworthy",
      "branchPolicy": "per-feature",
      "reviewPolicy": "risk-based",
      "lessonPolicy": "noteworthy-only",
      "graphPolicy": "cache-by-file-hash",
      "blastPolicy": "per-execution-unit",
      "cleanupPolicy": "script",
      "batchTasks": true,
      "implementerPer": "execution-unit",
      "maxTasksPerBatch": 5,
      "requireDualReviewOn": [
        "security",
        "migration",
        "public-api",
        "high-blast"
      ]
    },
    "strict": {
      "description": "Legacy high-assurance: per-task branch, blast, dual review, LESSONS every task",
      "branchPolicy": "per-task",
      "reviewPolicy": "always-dual",
      "lessonPolicy": "every-task",
      "graphPolicy": "rebuild-each-task",
      "blastPolicy": "per-task",
      "cleanupPolicy": "script",
      "batchTasks": false,
      "implementerPer": "task",
      "maxTasksPerBatch": 1,
      "requireDualReviewOn": ["*"]
    }
  },
  "reviewMatrix": {
    "documentation": {
      "spec": "skip",
      "code": "skip-or-lightweight",
      "unified": false
    },
    "test-only": { "spec": "skip", "code": "unified", "unified": true },
    "small-internal-refactor": {
      "spec": "skip",
      "code": "required",
      "unified": true
    },
    "small-feature-with-tests": {
      "spec": "unified",
      "code": "unified",
      "unified": true
    },
    "public-api": { "spec": "required", "code": "required", "unified": false },
    "authentication-security": {
      "spec": "required",
      "code": "required",
      "unified": false
    },
    "database-migration": {
      "spec": "required",
      "code": "required",
      "unified": false
    },
    "high-blast": { "spec": "required", "code": "required", "unified": false }
  },
  "classificationRules": {
    "version": 2,
    "default": "balanced",
    "hard_strict_triggers": [
      "security",
      "migration",
      "public_api",
      "credential_handling"
    ],
    "dual_review_triggers": [
      "security",
      "migration",
      "public_api",
      "credential_handling",
      "blast_risk_high"
    ],
    "risk_weights": {
      "files_changed_over_5": 1,
      "estimated_lines_over_200": 1,
      "files_changed_over_2": 0,
      "estimated_lines_over_50": 0,
      "generated_file_change": 1,
      "high_fan_in_symbol": 4,
      "missing_tests": 2,
      "cross_package_change": 3,
      "exported_symbol_change": 3,
      "config_schema_protocol": 3,
      "concurrency_async": 2,
      "dependency_update": 2,
      "database_storage": 3,
      "blast_risk_medium": 2,
      "blast_risk_high": 3,
      "many_direct_callers": 2
    },
    "thresholds": {
      "fast_max": 1,
      "balanced_max": 5,
      "strict_min": 6
    },
    "confidence_gates": {
      "fast_min": 0.85,
      "balanced_min": 0.65
    },
    "caller_thresholds": {
      "high_fan_in": 8,
      "many_direct": 15,
      "low_direct": 1
    },
    "direct_path": {
      "max_risk_score": 0,
      "max_files": 1,
      "max_lines": 30,
      "require_focused_validation": true,
      "forbid_exported_symbol_change": true,
      "min_confidence": 0.85,
      "allowed_classes": ["documentation", "formatting", "one_file_internal"]
    },
    "escalateToStrictOnHighBlast": false,
    "escalateReviewOnHighBlast": true,
    "allowExplicitOverride": true,
    "_deprecated_fastIf": {
      "_comment": "Legacy v1 shape. Nested 'or' was documented as AND (tiny internal). Migrated by scripts/lib/classify.js loadClassificationRules.",
      "documentationOnly": true,
      "or": {
        "filesChangedMax": 2,
        "estimatedLinesMax": 50,
        "notPublicApi": true,
        "notSecuritySensitive": true
      }
    },
    "_deprecated_strictIf": ["securitySensitive", "databaseMigration", "publicApi", "blastRiskHigh"]
  },
  "modelTiers": {
    "low": {
      "orchestrator": { "reasoningEffort": "low" },
      "implementer": { "reasoningEffort": "medium" },
      "unified-reviewer": { "reasoningEffort": "medium" },
      "spec-reviewer": { "reasoningEffort": "medium" },
      "code-reviewer": { "reasoningEffort": "medium" }
    },
    "medium": {
      "orchestrator": { "reasoningEffort": "medium" },
      "implementer": { "reasoningEffort": "high" },
      "unified-reviewer": { "reasoningEffort": "high" },
      "spec-reviewer": { "reasoningEffort": "high" },
      "code-reviewer": { "reasoningEffort": "high" }
    },
    "high": {
      "orchestrator": { "reasoningEffort": "high" },
      "implementer": { "reasoningEffort": "high" },
      "spec-reviewer": { "reasoningEffort": "max" },
      "code-reviewer": { "reasoningEffort": "max" },
      "reconciler": { "reasoningEffort": "max" }
    }
  }
}
