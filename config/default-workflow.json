{
  "_comment": "V5 single default workflow. No fast/balanced/strict profile matrix. Impact Engine risk still drives verification ladder intensity.",
  "workflow": "default",
  "branchPolicy": "per-feature",
  "reviewPolicy": "always-reviewer",
  "lessonPolicy": "noteworthy-only",
  "impactPolicy": "rebuild-each-task",
  "cleanupPolicy": "script",
  "batchTasks": false,
  "implementerPer": "task",
  "maxTasksPerBatch": 1,
  "maxParallelTasks": 1,
  "requireReviewerOn": ["*"],
  "requirePreImpactBeforeImplementer": true,
  "requirePostImpactBeforeReview": true,
  "agentCallsPerTask": {
    "implementer": 1,
    "reviewer": 1,
    "fixLoopExtra": 2
  }
}
