{
  "_comment": "V5 single default execution workflow. Planning depth and Plan Advisor use are adaptive; Impact Engine risk still drives verification ladder intensity.",
  "workflow": "default",
  "branchPolicy": "per-feature",
  "reviewPolicy": "always-reviewer",
  "lessonPolicy": "noteworthy-only",
  "impactPolicy": "rebuild-each-task",
  "impactIgnorePatterns": [
    ".git/**",
    ".node_modules/**",
    ".venv/**",
    "venv/**",
    "__pycache__/**",
    "*.pyc",
    "*.pyo",
    "dist/**",
    "build/**",
    "coverage/**",
    ".cache/**",
    ".tmp/**",
    ".antigravity/**"
  ],
  "scopePolicyPath": ".opencode/config/scope-policy.json",
  "cleanupPolicy": "script",
  "batchTasks": false,
  "implementerPer": "execution-unit",
  "executionUnitPer": "execution-unit",
  "maxTasksPerBatch": 1,
  "maxParallelTasks": 1,
  "requireReviewerOn": ["*"],
  "requirePreImpactBeforeImplementer": true,
  "requirePostImpactBeforeReview": true,
  "agentCallsPerTask": {
    "implementer": 1,
    "reviewer": 1,
    "fixLoopExtra": 2
  }
}
