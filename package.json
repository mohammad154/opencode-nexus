{
  "name": "@mohammad154/opencode-nexus",
  "version": "5.0.0",
  "description": "Fixed three-agent development workflow for OpenCode (orchestrator, implementer, reviewer + Impact Engine)",
  "type": "module",
  "main": ".opencode/plugins/nexus.js",
  "exports": "./.opencode/plugins/nexus.js",
  "bin": {
    "nexus": "bin/nexus.js",
    "opencode-nexus": "bin/nexus.js"
  },
  "files": [
    "bin/",
    ".opencode/plugins/",
    ".opencode/INSTALL.md",
    "agents/",
    "skills/",
    "config/",
    "scripts/",
    "schemas/",
    "docs/",
    "install.sh",
    "uninstall.sh"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:install": "bash scripts/test-install-only.sh && bash scripts/test-optional-agents.sh && bash scripts/test-uninstall-lifecycle.sh",
    "postinstall": "node ./scripts/ensure-cli-on-path.js",
    "preuninstall": "node ./scripts/ensure-cli-on-path.js --remove",
    "prepublishOnly": "npm test && npm run test:install"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammad154/opencode-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/mohammad154/opencode-nexus/issues"
  },
  "homepage": "https://github.com/mohammad154/opencode-nexus#readme",
  "keywords": [
    "opencode",
    "nexus",
    "multi-agent",
    "workflow",
    "plugin",
    "orchestrator"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
