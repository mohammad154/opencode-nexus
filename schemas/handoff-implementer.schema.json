{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-nexus.local/schemas/handoff-implementer.schema.json",
  "title": "ImplementerHandoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "agent": { "type": "string" },
    "task_id": { "type": "string" },
    "unit_or_task": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DONE", "DONE_WITH_CONCERNS", "BLOCKED", "NEEDS_CONTEXT"]
    },
    "commit": { "type": ["string", "null"] },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": ["string", "object"] } },
    "blast_verified": { "type": ["boolean", "null"] },
    "tasks_completed": { "type": "array", "items": { "type": "string" } },
    "notes_for_reviewer": { "type": "string" },
    "scope_extras": { "type": "array", "items": { "type": "string" } },
    "verification_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "cmd": { "type": "string" },
          "expected": {},
          "actual": {},
          "pass": { "type": "boolean" }
        }
      }
    },
    "drift_check": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "plan_commit": { "type": ["string", "null"] },
        "current_head": { "type": ["string", "null"] },
        "pass": { "type": ["boolean", "null"] }
      }
    },
    "blast": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "risk": { "type": "string" },
        "verified": { "type": ["boolean", "null"] },
        "callers_checked": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
