{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-nexus.local/schemas/handoff-implementer.schema.json",
  "title": "ImplementerHandoff",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{ "$ref": "handoff-envelope.schema.json" }],
  "required": [
    "schema_version",
    "run_id",
    "unit_or_task",
    "agent",
    "base_commit",
    "created_at",
    "status",
    "commit",
    "verification_gates",
    "drift_check"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.1"] },
    "agent": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string" },
    "unit_or_task": { "type": "string", "minLength": 1 },
    "reviewed_commit": { "type": ["string", "null"] },
    "base_commit": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "legacy_unverified": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["DONE", "DONE_WITH_CONCERNS", "BLOCKED", "NEEDS_CONTEXT"]
    },
    "commit": { "type": ["string", "null"] },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": ["string", "object"] } },
    "blast_verified": { "type": ["boolean", "null"] },
    "impact_verified": { "type": ["boolean", "null"] },
    "tdd_required": { "type": "boolean" },
    "tdd": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "red": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "exit_code": { "type": "number" }
          }
        },
        "green": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "exit_code": { "type": "number" }
          }
        }
      }
    },
    "tasks_completed": { "type": "array", "items": { "type": "string" } },
    "notes_for_reviewer": { "type": "string" },
    "scope_extras": { "type": "array", "items": { "type": "string" } },
    "verification_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "cmd": { "type": "string" },
          "expected": {},
          "actual": {},
          "pass": { "type": "boolean" }
        }
      }
    },
    "drift_check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["pass"],
      "properties": {
        "plan_commit": { "type": ["string", "null"] },
        "current_head": { "type": ["string", "null"] },
        "pass": { "type": ["boolean", "null"] }
      }
    },
    "blast": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "risk": { "type": "string" },
        "verified": { "type": ["boolean", "null"] },
        "artifact_digest": { "type": "string" },
        "callers_checked": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
