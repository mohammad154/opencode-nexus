{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-nexus.local/schemas/handoff-spec-reviewer.schema.json",
  "title": "SpecReviewerHandoff",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{ "$ref": "handoff-envelope.schema.json" }],
  "required": [
    "schema_version",
    "run_id",
    "unit_or_task",
    "agent",
    "base_commit",
    "created_at",
    "verdict",
    "reviewed_commit"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.1"] },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string" },
    "unit_or_task": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "enum": ["spec-reviewer"] },
    "reviewed_commit": { "type": ["string", "null"] },
    "base_commit": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "role": { "type": "string" },
    "legacy_unverified": { "type": "boolean" },
    "verdict": {
      "type": "string",
      "enum": ["APPROVED", "REQUEST_CHANGES", "ISOLATION_VIOLATION", "BLOCKED"]
    },
    "plan_commit": { "type": ["string", "null"] },
    "drift": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "detected": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "acceptance": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "blast": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "risk": { "type": "string" },
        "callers_reviewed": { "type": "array", "items": { "type": "string" } },
        "pass": { "type": ["boolean", "null"] }
      }
    },
    "findings": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  }
}
