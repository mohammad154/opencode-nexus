{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-nexus.local/schemas/run-state.schema.json",
  "title": "NexusRunState",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "state", "transitions"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "CREATED",
        "BRAINSTORMING",
        "WAITING_FOR_USER",
        "PLANNED",
        "TASK_IMPACT_READY",
        "IMPLEMENTING",
        "VERIFYING",
        "REVIEWING",
        "FINAL_VERIFYING",
        "FINAL_REVIEWING",
        "COMPLETED",
        "BLOCKED",
        "FAILED"
      ]
    },
    "workflow": { "type": "string", "enum": ["default"] },
    "execution_mode": { "type": "string", "enum": ["delegated"] },
    "planning_mode": { "type": ["string", "null"], "enum": ["compact", "standard", "deep", null] },
    "plan_advisor_calls": { "type": "integer", "minimum": 0 },
    "plan_advisor": { "type": ["object", "null"], "additionalProperties": true },
    "plan_advisor_handoff": { "type": ["object", "null"], "additionalProperties": true },
    "plan_check": { "type": ["object", "null"], "additionalProperties": true },
    "execution_units": { "type": ["array", "null"], "items": { "type": "object", "additionalProperties": true } },
    "units": { "type": ["array", "null"], "items": { "type": "object", "additionalProperties": true } },
    "compatibility_mode": { "type": ["string", "null"] },
    "require_post_impact": { "type": "boolean" },
    "verification_status": {
      "type": ["string", "null"],
      "enum": ["PENDING", "RUNNING", "PASSED", "FAILED", "TIMED_OUT", null]
    },
    "verification": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING", "RUNNING", "PASSED", "FAILED", "TIMED_OUT"]
        },
        "phase": { "type": ["string", "null"], "enum": ["TASK", "FINAL", null] },
        "worktree_head": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "plan_digest": { "type": ["string", "null"] },
        "configuration_digest": { "type": ["string", "null"] },
        "artifact_path": { "type": ["string", "null"] },
        "artifact_digest": { "type": ["string", "null"] },
        "current_step": { "type": "integer", "minimum": 0 },
        "total_steps": { "type": "integer", "minimum": 0 },
        "completed_steps": { "type": "integer", "minimum": 0 },
        "failure_reason": { "type": ["string", "null"] }
      }
    },
    "current_unit": { "type": ["string", "null"] },
    "pending_review_findings": {
      "type": ["array", "null"],
      "items": { "type": "object", "additionalProperties": true }
    },
    "fix_loop_attempts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "plan_commit": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "impact": { "type": ["object", "null"], "additionalProperties": true },
    "blocked_from": { "type": ["string", "null"] },
    "resume_state": { "type": ["string", "null"] },
    "block_reason": { "type": ["string", "null"] },
    "block_code": { "type": ["string", "null"] },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "at": { "type": "string" },
          "evidence": { "type": ["string", "object", "null"] }
        }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
