{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-nexus.local/schemas/run-state.schema.json",
  "title": "NexusRunState",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "state", "transitions"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "CREATED",
        "BRAINSTORMING",
        "WAITING_FOR_USER",
        "PLANNED",
        "TASK_IMPACT_READY",
        "IMPLEMENTING",
        "VERIFYING",
        "REVIEWING",
        "FINAL_VERIFYING",
        "FINAL_REVIEWING",
        "COMPLETED",
        "BLOCKED",
        "FAILED"
      ]
    },
    "workflow": { "type": "string", "enum": ["default"] },
    "execution_mode": { "type": "string", "enum": ["delegated"] },
    "compatibility_mode": { "type": ["string", "null"] },
    "require_post_impact": { "type": "boolean" },
    "current_unit": { "type": ["string", "null"] },
    "pending_review_findings": {
      "type": ["array", "null"],
      "items": { "type": "object", "additionalProperties": true }
    },
    "plan_commit": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "impact": { "type": ["object", "null"], "additionalProperties": true },
    "blocked_from": { "type": ["string", "null"] },
    "resume_state": { "type": ["string", "null"] },
    "block_reason": { "type": ["string", "null"] },
    "block_code": { "type": ["string", "null"] },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "at": { "type": "string" },
          "evidence": { "type": ["string", "object", "null"] }
        }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
