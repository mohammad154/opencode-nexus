{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-nexus.local/schemas/run-state.schema.json",
  "title": "NexusRunState",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "state", "profile", "transitions"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "CREATED",
        "CLASSIFIED",
        "PLANNED",
        "GRAPH_READY",
        "BLAST_READY",
        "IMPLEMENTING",
        "DIRECT_IMPLEMENTING",
        "VERIFYING",
        "REVIEWING",
        "COMPLETED",
        "BLOCKED",
        "FAILED"
      ]
    },
    "profile": { "type": "string", "enum": ["fast", "balanced", "strict"] },
    "review_level": { "type": "string", "enum": ["none", "unified", "dual"] },
    "execution_mode": { "type": "string", "enum": ["direct", "delegated"] },
    "current_unit": { "type": ["string", "null"] },
    "classification": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "plan_commit": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "graph": { "type": ["object", "null"], "additionalProperties": true },
    "blast": { "type": ["object", "null"], "additionalProperties": true },
    "block_reason": { "type": ["string", "null"] },
    "block_code": { "type": ["string", "null"] },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "at": { "type": "string" },
          "evidence": { "type": ["string", "object", "null"] }
        }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
