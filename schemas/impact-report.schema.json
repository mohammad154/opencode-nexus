{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-nexus.local/schemas/impact-report.schema.json",
  "title": "NexusImpactReport",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "risk", "confidence"],
  "properties": {
    "schema_version": { "type": "string" },
    "ok": { "type": "boolean" },
    "provider": { "type": "string" },
    "base_commit": { "type": ["string", "null"] },
    "head_commit": { "type": ["string", "null"] },
    "changed_files": { "type": "array" },
    "changed_symbols": { "type": "array" },
    "direct_dependents": { "type": "array" },
    "transitive_dependents": { "type": "array" },
    "affected_packages": { "type": "array" },
    "related_tests": { "type": "array" },
    "risk": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification_mode": {
      "type": "string",
      "enum": ["targeted", "wider", "strict"]
    },
    "trusted": { "type": "boolean" },
    "analysis_quality": { "type": "string" },
    "analysis_complete": { "type": "boolean" },
    "uncertainties": { "type": "array" },
    "artifact_digest": { "type": "string" },
    "provider_validated": { "type": "boolean" },
    "worktree_head": { "type": ["string", "null"] }
  }
}
